# 복사해서 .env 로 쓴다. .env 는 git 에서 제외된다.
DATABASE_URL=postgresql+asyncpg://localhost:5432/songwol_qr
JWT_SECRET=change-me-jwt
CHECKCODE_SECRET=change-me-checkcode
# 체크코드 비밀키 회전 시 이전 세대 (검증만 허용). 평소에는 비워 둔다.
CHECKCODE_SECRET_PREV=
# python -m app.db.seed 가 admin 계정에 넣을 비밀번호. 비우면 admin 은 로그인 불가 상태로 생성.
SEED_ADMIN_PASSWORD=
TZ=Asia/Seoul
PRINTER_HOST=
PRINTER_PORT=9100
